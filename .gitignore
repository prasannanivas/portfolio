*.pem
*.key
*.crt
*.p12
*.pfx
*.cer
*.ppk
id_rsa*
.env
.env.*
!.env.example
*.secret
secrets.*
credentials*.json

# ---------- logs & caches ----------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log
.eslintcache
.cache/
.parcel-cache/
.vercel/
.netlify/

# ---------- editors & OS ----------
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ---------- local scratch ----------
*.zip
*.tmp
